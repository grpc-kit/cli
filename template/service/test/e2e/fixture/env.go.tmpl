//go:build e2e

// Package fixture 提供 E2E 测试的环境引导：服务地址、调用凭据与本次运行的唯一数据前缀。
// 建议所有测试数据（名称、编码等）都带 RunID 前缀，便于清理与并发隔离。
package fixture

import (
	"crypto/rand"
	"encoding/hex"
	"fmt"
	"os"
	"time"
)

// 被测服务的默认地址与服务代码，取自 config/app-dev-local.yaml。
// 可用环境变量覆盖：E2E_BASE_URL / E2E_SERVICE_CODE。
const (
	defaultBaseURL     = "http://127.0.0.1:8080"
	defaultServiceCode = "{{ .Global.ShortName }}.{{ .Template.Service.APIVersion }}.{{ .Global.ProductCode }}"
)

// Env 汇总 E2E 运行所需的环境配置。
type Env struct {
	// BaseURL 是被测服务地址，默认 http://127.0.0.1:8080。
	BaseURL string
	// ServiceCode 是服务代码，格式「应用短名.接口版本.产品代码」，健康检查需要它作为入参。
	ServiceCode string
	// RunID 是本次运行的唯一短标识，嵌入测试数据前缀。
	RunID string
}

// env 返回进程级单例（TestMain 前初始化一次）。
var env *Env

// Init 初始化环境配置；重复调用返回已初始化的实例。
func Init() *Env {
	if env != nil {
		return env
	}
	env = &Env{
		BaseURL:     getenv("E2E_BASE_URL", defaultBaseURL),
		ServiceCode: getenv("E2E_SERVICE_CODE", defaultServiceCode),
		RunID:       newRunID(),
	}
	return env
}

// newRunID 生成短随机标识：时间戳后 6 位数字 + 2 字节随机十六进制。
// 保持简短以适配各类标识常见的长度约束。
func newRunID() string {
	buf := make([]byte, 2)
	if _, err := rand.Read(buf); err != nil {
		panic(fmt.Sprintf("fixture: generate run id: %v", err))
	}
	return fmt.Sprintf("%s%s", time.Now().Format("150405"), hex.EncodeToString(buf))
}

// getenv 读取环境变量，空则返回默认值。
func getenv(key, def string) string {
	if v := os.Getenv(key); v != "" {
		return v
	}
	return def
}

// Prefix 返回测试数据前缀，如 "e2e153012ab12-"。
func (e *Env) Prefix() string { return "e2e" + e.RunID + "-" }

// Name 生成一个带本次运行前缀的名称，超过 32 字符则截断。
// 各业务标识（用户名、邮箱、资源编码等）的字符集与长度规则各不相同，
// 请按需在此追加专用生成器，如 Username(hint) / Email(hint)。
func (e *Env) Name(hint string) string {
	name := e.Prefix() + hint
	if len(name) > 32 {
		name = name[:32]
	}
	return name
}
