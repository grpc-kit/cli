#!/bin/bash

set -e

source scripts/env

function gen_protoc() {
  mkdir -p ./public/openapi
  rm -f ./public/openapi/microservice.swagger.json
  test -f "${GOPATH}"/src/github.com/grpc-kit/api/known/status/v1/response.proto

  # 生成 *.pb.go 文件
  # 同时兼容新旧工具链的 well-known types 位置：优先 ${GOPATH}/include（binaries.sh 安装，与 protoc 版本配对），回退 /usr/local/include（v0.3.8 旧版安装位置）
  protoc \
    -I ./ \
    -I "${GOPATH}"/include/ \
    -I /usr/local/include/ \
    -I "${GOPATH}"/src \
    -I "${GOPATH}"/src/github.com/grpc-ecosystem/grpc-gateway/ \
    -I "${GOPATH}"/src/github.com/googleapis/googleapis/ \
    --go_opt paths=source_relative \
    --go_out ./ \
    --go-grpc_opt paths=source_relative \
    --go-grpc_opt require_unimplemented_servers=false \
    --go-grpc_out ./ \
    ./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/*.proto

  # 生成 *.pb.gw.go 与 swagger 接口文档
  protoc \
    -I ./ \
    -I "${GOPATH}"/include/ \
    -I /usr/local/include/ \
    -I "${GOPATH}"/src \
    -I "${GOPATH}"/src/github.com/googleapis/googleapis/ \
    -I "${GOPATH}"/src/github.com/grpc-ecosystem/grpc-gateway/ \
    --grpc-gateway_opt paths=source_relative \
    --grpc-gateway_opt grpc_api_configuration=./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/microservice.gateway.yaml \
    --grpc-gateway_out ./ \
    --openapiv2_opt disable_default_errors=true \
    --openapiv2_opt disable_service_tags=true \
    --openapiv2_opt grpc_api_configuration=./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/microservice.gateway.yaml \
    --openapiv2_opt openapi_configuration=./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/microservice.openapiv2.yaml \
    --openapiv2_opt allow_merge=true \
    --openapiv2_opt merge_file_name=microservice \
    --openapiv2_out=json_names_for_fields=false:./public/openapi \
    ./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/microservice.proto \
    "${GOPATH}"/src/github.com/grpc-kit/api/known/status/v1/response.proto

  test -s ./public/openapi/microservice.swagger.json
  cp ./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/microservice.gateway.yaml ./public/openapi/
  cp ./api/${PRODUCT_CODE}/${SHORT_NAME}/${API_VERSION}/microservice.openapiv2.yaml ./public/openapi/
}

function gen_ent() {
  # 因 "go generate" 会继承 "GOOS" 与 "GOARCH" 变量，如在交叉编译环境则可能无法运行
  GOOS=${GOHOSTOS} GOARCH=${GOHOSTARCH} go generate ./modeler/ent/
}

if test -z $1; then
  gen_protoc
else
  $1
fi
